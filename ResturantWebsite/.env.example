# Copy to .env and edit. Never put secrets here: VITE_ variables are public in the browser bundle.

# WhatsApp number in international format, digits only (no +, spaces or dashes)
VITE_WHATSAPP_NUMBER=923000000000

# Optional: external ordering link (Foodpanda, your own store, etc.).
# If empty, "Order" buttons use the built-in DEMO checkout.
VITE_EXTERNAL_ORDER_URL=

# Optional: Google Maps embed URL (Share > Embed a map > copy the src="..." value)
VITE_MAPS_EMBED_URL=